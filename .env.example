VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — used by the /api/parse-ingredients Vercel function to call
# the Anthropic API. Set this in the Vercel dashboard (Project Settings →
# Environment Variables). Add it to .env locally only if you run `vercel dev`.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-side only — every /api function verifies the caller's Supabase session
# and household membership. Set in the Vercel dashboard. SUPABASE_URL can be
# omitted if VITE_SUPABASE_URL is set there. The service key may be a legacy
# service_role JWT or a new sb_secret_... key (sent only as the apikey header).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Server-side only — signs the Babory family session cookie and keys the
# wrong-PIN counters (HMAC of IP / device id). Long random string (e.g. 32+
# random bytes, base64). Changing it signs every family device out.
BABORY_SESSION_SECRET=your-long-random-secret
